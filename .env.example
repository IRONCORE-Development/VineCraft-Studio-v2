# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Server-side Anthropic API key to run the Anthropic Claude agent via /api/ai/*
# ANTHROPIC_API_KEY=""

# Optional: Custom routing method keys (server-side only; defaults stay unchanged)
# CUSTOM_GEMINI_API_KEY=""
# CUSTOM_ANTHROPIC_API_KEY=""
# OPENROUTER_API_KEY=""

# Optional: HTTPS OpenAI-compatible cloud endpoint (no browser key UI)
# CUSTOM_AI_ENDPOINT_URL="https://openrouter.ai/api/v1/chat/completions"
# CUSTOM_AI_API_KEY=""
